# ============================================
# VendyTrack - Variables de Entorno
# ============================================

# Base de datos PostgreSQL (OBLIGATORIO)
DATABASE_URL="postgresql://user:password@host:5432/vendytrack?sslmode=require"

# Conexión directa (sin pooler) para migraciones Prisma
DIRECT_URL="postgresql://user:password@host:5432/vendytrack?sslmode=require"

# Clave secreta de sesión (OBLIGATORIO - mínimo 32 caracteres)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Token de Vercel Blob Storage (OBLIGATORIO para fotos y PDFs)
BLOB_READ_WRITE_TOKEN=""

# URL pública de la aplicación (para enlaces en WhatsApp)
NEXT_PUBLIC_APP_URL="https://vendytrack.vercel.app"

# Habilitar reinicio del sistema (solo para desarrollo)
# ENABLE_SYSTEM_RESET="true"
