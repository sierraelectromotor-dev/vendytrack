# Conexión a Base de Datos (Vercel Postgres / Supabase con Connection Pooling)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vendytrack?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vendytrack"

# Vercel Blob Storage Token (Obtenido desde el panel de Vercel Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_demo_token_development"

# NextAuth / Auth.js Config
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super_secret_jwt_key_for_vendytrack_pwa_serverless_2026"
